	<queryString language="SQL">
		<![CDATA[SELECT
     employees.`id` AS employees_id,
     employees.`name` AS employees_name,
     employees.`gender` AS employees_gender,
     employees.`place_of_birth` AS employees_place_of_birth,
     employees.`date_of_birth` AS employees_date_of_birth,
     employees.`address` AS employees_address,
     employees.`religion` AS employees_religion,
     employees.`status` AS employees_status,
     employees.`phone_number` AS employees_phone_number,
     employees.`username` AS employees_username,
     employees.`password` AS employees_password,
     employees.`role_id` AS employees_role_id,
     roles.`id` AS roles_id,
     roles.`name` AS roles_name
FROM
     `employees` employees
     INNER JOIN `roles` roles ON employees.`role_id` = roles.`id`
WHERE
     employees.`name` <> 'Si Admin';]]>
	</queryString>
