	<parameter name="logoPath" class="java.lang.String"/>
	<parameter name="START_DATE_QUERY" class="java.lang.String"/>
	<parameter name="END_DATE_QUERY" class="java.lang.String"/>
	<parameter name="START_DATE" class="java.lang.String"/>
	<parameter name="END_DATE" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT
    CONCAT(
        DATE_FORMAT(employees.created_at, '%d'),
        ' ',
        CASE DATE_FORMAT(employees.created_at, '%M') WHEN 'January' THEN 'Januari' WHEN 'February' THEN 'Februari' WHEN 'March' THEN 'Maret' WHEN 'April' THEN 'April' WHEN 'May' THEN 'Mei' WHEN 'June' THEN 'Juni' WHEN 'July' THEN 'Juli' WHEN 'August' THEN 'Agustus' WHEN 'September' THEN 'September' WHEN 'October' THEN 'Oktober' WHEN 'November' THEN 'November' WHEN 'December' THEN 'Desember'
    END,
    ' ',
    DATE_FORMAT(employees.created_at, '%Y')
) AS tanggal,
employees.id AS employees_id,
employees.name AS employees_name,
employees.gender AS employees_gender,
employees.place_of_birth AS employees_place_of_birth,
employees.date_of_birth AS employees_date_of_birth,
employees.address AS employees_address,
employees.religion AS employees_religion,
employees.status AS employees_status,
employees.phone_number AS employees_phone_number,
employees.username AS employees_username,
employees.password AS employees_password,
employees.role_id AS employees_role_id,
roles.id AS roles_id,
roles.name AS roles_name
FROM
    employees employees
INNER JOIN roles roles ON
    employees.role_id = roles.id
WHERE
    employees.name <> 'Si Admin'
    AND employees.`created_at` BETWEEN $P{START_DATE_QUERY} AND $P{END_DATE_QUERY};]]>
	</queryString>
