		</conditionalStyle>
	</style>
	<parameter name="YEAR" class="java.lang.String"/>
	<parameter name="logoPath" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
  ROW_NUMBER() OVER (ORDER BY transactions.id) as seq_num,
  transactions.status, 
  CONCAT(
        DATE_FORMAT(transactions.created_at, '%d'),
        ' ',
        CASE DATE_FORMAT(transactions.created_at, '%M') WHEN 'January' THEN 'Januari' WHEN 'February' THEN 'Februari' WHEN 'March' THEN 'Maret' WHEN 'April' THEN 'April' WHEN 'May' THEN 'Mei' WHEN 'June' THEN 'Juni' WHEN 'July' THEN 'Juli' WHEN 'August' THEN 'Agustus' WHEN 'September' THEN 'September' WHEN 'October' THEN 'Oktober' WHEN 'November' THEN 'November' WHEN 'December' THEN 'Desember'
    END,
    ' ',
    DATE_FORMAT(transactions.created_at, '%Y')
) AS tanggal,
  customers.name, 
  segments.name as "segment_name", 
  customers.person_in_charge as "pic", 
  customers.phone_number, 
  items.name as "item_name", 
  transactions.Qty as qty, 
  items.price_per_unit as "price", 
  transactions.Total as "sub_total", 
  "11%" as "ppn", 
  transactions.Total + (transactions.Total * 0.11) as "total_amount" 
FROM transactions 
INNER JOIN customers ON transactions.customer_id = customers.id 
INNER JOIN segments ON customers.segment_id = segments.id 
INNER JOIN items ON transactions.item_id = items.id
WHERE YEAR(transactions.created_at) = $P{YEAR}]]>
	</queryString>
