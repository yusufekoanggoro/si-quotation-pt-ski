	<parameter name="Year" class="java.lang.String"/>
	<parameter name="logoPath" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
  ROW_NUMBER() OVER (ORDER BY transactions.id) as seq_num,
  transactions.id, 
  transactions.status, 
  transactions.created_at, 
  customers.name, 
  segments.name as "segment_Name", 
  customers.person_in_charge as "pic", 
  customers.phone_number, 
  items.name as "item_name", 
  transactions.Qty as qty, 
  items.price_per_unit as "price", 
  transactions.Total as "sub_total", 
  "11%" as "ppn", 
  transactions.Total + (transactions.Total * 0.11) as "total_amount" 
FROM quotations_management.transactions 
INNER JOIN quotations_management.customers ON transactions.customer_id = customers.id 
INNER JOIN quotations_management.segments ON customers.segment_id = segments.id 
INNER JOIN quotations_management.items ON transactions.item_id = items.id
WHERE YEAR(quotations_management.transactions.created_at) = $P{Year}]]>
	</queryString>
