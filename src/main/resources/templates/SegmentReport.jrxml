	<parameter name="logoPath" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT
	segments.id,
    CONCAT(
        DATE_FORMAT(segments.created_at, '%d'),
        ' ',
        CASE DATE_FORMAT(segments.created_at, '%M') WHEN 'January' THEN 'Januari' WHEN 'February' THEN 'Februari' WHEN 'March' THEN 'Maret' WHEN 'April' THEN 'April' WHEN 'May' THEN 'Mei' WHEN 'June' THEN 'Juni' WHEN 'July' THEN 'Juli' WHEN 'August' THEN 'Agustus' WHEN 'September' THEN 'September' WHEN 'October' THEN 'Oktober' WHEN 'November' THEN 'November' WHEN 'December' THEN 'Desember'
    END,
    ' ',
    DATE_FORMAT(segments.created_at, '%Y')
) AS tanggal,
segments.name
FROM
    segments]]>
	</queryString>
